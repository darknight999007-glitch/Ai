.m{color:var(--m);font-size:13px}
input,select,textarea{width:100%;padding:12px;border-radius:12px;border:1px solid var(--bd);background:rgba(0,0,0,.3);color:var(--t);font:inherit;margin:5px 0;outline:none}
input:focus,select:focus{border-color:var(--a)}
button{font:inherit;border:0;border-radius:12px;padding:11px 16px;color:#04121f;font-weight:700;background:linear-gradient(90deg,var(--a),var(--b));cursor:pointer;transition:transform .15s}
button:active{transform:scale(.94)}
button.g{background:var(--card);color:var(--t);border:1px solid var(--bd)}
button.r{background:var(--er);color:#fff}button.k{background:var(--ok)}
.row{display:flex;gap:8px;align-items:center;justify-content:space-between}
.orbwrap{text-align:center;margin:8px 0 14px}
.orb{width:130px;height:130px;margin:auto;border-radius:50%;display:grid;place-items:center;font-weight:800;font-size:22px;cursor:pointer;background:radial-gradient(circle at 35% 30%,#2a3170,#0b1030);border:2px solid var(--bd);color:var(--m);transition:.4s;position:relative}
