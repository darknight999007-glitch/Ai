    if(rec){buf.push(new Float32Array(d));len+=dt;if(rms<=th){sil+=dt;if(sil>1.1)fin()}if(len>14)fin()}
    if(S.hear!==rec){S.hear=rec;stl()}
  };
  src.connect(pr);pr.connect(ac.destination);ear={st,ac,src,pr};S.pulse=Date.now();
}
