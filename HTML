#toast.show{transform:translate(-50%,0)}
.ov{position:fixed;inset:0;background:#000a;display:grid;place-items:end center;z-index:50;animation:pop .25s}
.sheet{background:#0d1233;border:1px solid var(--bd);border-radius:22px 22px 0 0;padding:18px;width:100%;max-width:520px}
h3{margin:4px 0 8px}
.opt{display:block;padding:11px;border:1px solid var(--bd);border-radius:12px;margin:6px 0}
.opt input{width:auto;margin-right:8px}
@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}

body::before,body::after{content:"";position:fixed;width:340px;height:340px;border-radius:50%;filter:blur(90px);opacity:.35;z-index:-1;animation:float 14s ease-in-out infinite alternate}
body::before{background:#7b5cff;top:-80px;left:-80px}body::after{background:#00e0ff;bottom:-100px;right:-80px;animation-delay:-7s}
@keyframes float{to{transform:translate(90px,70px) scale(1.25)}}
.card{animation:pop .5s both}.card:nth-child(2){animation-delay:.06s}.card:nth-child(3){animation-delay:.12s}.card:nth-child(4){animation-delay:.18s}.card:nth-child(5){animation-delay:.24s}
button:not(.g):not(.r):not(.k){background-size:200% 100%;animation:shine 3s linear infinite}
@keyframes shine{to{background-position:200% 0}}
nav button{transition:.3s}
.wave{position:absolute;display:flex;gap:4px;align-items:center;height:60px;opacity:0;transition:.4s}
.orb.on .wave{opacity:.9}
.wave i{width:5px;height:12px;border-radius:9px;background:#fff;animation:eq 1s ease-in-out infinite}
.wave i:nth-child(2){animation-delay:.15s}.wave i:nth-child(3){animation-delay:.3s}.wave i:nth-child(4){animation-delay:.45s}.wave i:nth-child(5){animation-delay:.6s}
@keyframes eq{50%{height:52px}}
.orb b{position:absolute;bottom:22px;font-size:14px}
.plan{position:relative;overflow:hidden;transition:.3s}
.plan:hover{transform:translateY(-4px);box-shadow:0 10px 30px #7b5cff44}
.plan::before{content:"";position:absolute;top:0;left:-120%;width:60%;height:100%;background:linear-gradient(100deg,transparent,#ffffff22,transparent);animation:sweep 3.5s infinite}
@keyframes sweep{to{left:160%}}
.dots{display:inline-flex;gap:4px}.dots i{width:7px;height:7px;border-radius:50%;background:var(--a);animation:bounce 1s infinite}
.dots i:nth-child(2){animation-delay:.15s}.dots i:nth-child(3){animation-delay:.3s}
@keyframes bounce{50%{transform:translateY(-6px);opacity:.4}}
.sheet{animation:slide .35s cubic-bezier(.2,.9,.3,1)}
@keyframes slide{from{transform:translateY(100%)}}
.steps{display:flex;gap:6px;margin:6px 0 12px}.steps span{flex:1;height:4px;border-radius:9px;background:var(--bd)}.steps span.d{background:linear-gradient(90deg,var(--a),var(--b))}
.pm{display:flex;gap:8px;margin:8px 0}
.pm label{flex:1;text-align:center;padding:12px 4px;border-radius:14px;border:2px solid var(--bd);cursor:pointer;transition:.25s;font-size:13px;font-weight:700}
.pm label input{display:none}
.pm label.sel{transform:scale(1.05);color:#fff}
.pm label.bkash.sel{background:#e2136e;border-color:#e2136e;box-shadow:0 0 22px #e2136e88}
.pm label.nagad.sel{background:#f6921e;border-color:#f6921e;box-shadow:0 0 22px #f6921e88}
.pm label.bank.sel{background:#2a6df4;border-color:#2a6df4;box-shadow:0 0 22px #2a6df488}
.paybox{background:rgba(0,0,0,.35);border:1px dashed var(--a);border-radius:14px;padding:12px;margin:8px 0;animation:pop .3s}
