.msg{max-width:85%;padding:10px 13px;border-radius:16px;animation:pop .3s;white-space:pre-wrap;line-height:1.5;font-size:14px}
.msg.u{align-self:flex-end;background:linear-gradient(90deg,var(--a),var(--b));color:#04121f;border-bottom-right-radius:4px}
.msg.b{align-self:flex-start;background:var(--card);border:1px solid var(--bd);border-bottom-left-radius:4px}
.bar{display:flex;gap:6px;margin-top:8px}.bar input{margin:0}
.price{font-size:24px;font-weight:800;color:var(--a)}
