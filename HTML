.ok-wrap path{stroke:var(--ok);stroke-width:5;fill:none;stroke-linecap:round;stroke-dasharray:50;stroke-dashoffset:50;animation:draw .4s .5s forwards}
@keyframes draw{to{stroke-dashoffset:0}}
.adm-badge{background:linear-gradient(90deg,#ff5c7a,#ffb020);color:#04121f;font-size:11px;font-weight:800;padding:3px 9px;border-radius:99px;margin-left:6px}
.face{position:absolute;top:14px;font-size:36px;animation:bob 2.4s ease-in-out infinite;filter:drop-shadow(0 0 10px #00e0ff88)}
.orb .wave{margin-top:34px;transform:scaleY(.6)}
@keyframes bob{50%{transform:translateY(-6px)}}
@keyframes shake{25%{transform:rotate(-12deg) scale(1.15)}75%{transform:rotate(12deg) scale(1.15)}}
@keyframes beat{50%{transform:scale(1.3)}}
.face.m-excited{animation:shake .5s infinite}.face.m-love{animation:beat .8s infinite}.face.m-sad{animation:bob 4s infinite;filter:grayscale(.5)}.face.m-thinking{animation:spin 3s linear infinite}
body.arch{--a:#39ff6a;--b:#10b981;--bg:#040705;background:radial-gradient(ellipse at 50% -10%,#134a25,#040705 62%) fixed}
body.arch::before{background:#10b981}body.arch::after{background:#facc15;opacity:.18}
body.adm{--a:#ff9f1a;--b:#ff5c7a;background:radial-gradient(circle at 80% -10%,#3a1450,#080a18 60%) fixed}
body.adm::before{background:#ff5c7a}body.adm::after{background:#7b5cff}
.tb{display:flex;justify-content:space-between;align-items:center;margin-bottom:6px}
.tt{letter-spacing:2px;font-size:15px}.sq{width:42px;height:42px;padding:0;font-size:18px;border-radius:12px}
.stat{text-align:center;margin:2px 0}
.hub{position:relative;aspect-ratio:360/300;margin:4px 0}
.hub svg{position:absolute;inset:0;width:100%;height:100%}
.ln{fill:none;stroke-width:2.4;stroke-dasharray:6 8;animation:flow 1.1s linear infinite;filter:drop-shadow(0 0 4px currentColor)}
@keyframes flow{to{stroke-dashoffset:-14}}
.pl{position:absolute;left:0;width:29%;height:11%;display:flex;align-items:center;gap:5px;padding:0 6px 0 4px;border-radius:99px;border:2px solid;background:rgba(0,0,0,.6);font-size:10px;font-weight:800;letter-spacing:.5px}
.pl i{font-style:normal;width:22px;height:22px;flex:none;border-radius:50%;display:grid;place-items:center;font-size:11px;border:2px solid}
.pl:hover{transform:translateX(4px)}
.sph{position:absolute;left:50%;top:20%;width:47.2%;height:56.7%;border-radius:50%;border:2px solid #39ff6ab3;box-shadow:0 0 30px #39ff6a44,inset 0 0 30px #22d3ee26;cursor:pointer;display:grid;place-items:center;transition:.5s}
.sph::after{content:"";position:absolute;inset:-9px;border-radius:50%;border:1px dashed #22d3ee80;animation:spin 12s linear infinite}
.sph canvas{width:100%;height:100%;transition:.5s}.sph.off canvas{opacity:.3}.sph.off{box-shadow:none;border-color:var(--bd)}
.sph span{position:absolute;bottom:7%;font-size:9px;font-weight:800;letter-spacing:1px}
.ctl{justify-content:center;gap:10px;margin:6px 0}
.stop{border:2px solid var(--er);border-radius:99px;padding:9px 24px;background:transparent}
.bot{display:grid;grid-template-columns:1fr 1.15fr;gap:12px;margin-top:12px}
.hl b,.tk b{font-size:12px;letter-spacing:.5px}.hli{font-size:12px;margin:8px 0;color:var(--t);animation:pop .4s}
.tk{border:1.5px solid #ffffff8c;border-radius:18px;padding:12px;background:rgba(0,0,0,.4);min-height:110px}
.pb{height:4px;background:var(--bd);border-radius:9px;margin:8px 0}.pb i{display:block;height:100%;background:var(--a);border-radius:9px;transition:width .6s;box-shadow:0 0 8px var(--a)}
.ti{display:flex;gap:8px;font-size:12px;margin:8px 0;cursor:pointer}
.ti i{width:8px;height:8px;border:2px solid var(--a);border-radius:50%;margin-top:4px;flex:none;transition:.3s}
.ti.d{opacity:.5;text-decoration:line-through}.ti.d i{background:var(--a)}
.face2{font-size:64px;text-align:center;animation:bob 2.4s ease-in-out infinite}
.face2.m-excited{animation:shake .5s infinite}.face2.m-love{animation:beat .8s infinite}.face2.m-thinking{animation:spin 3s linear infinite}
.chips{display:flex;flex-wrap:wrap;gap:8px}.chips button{flex:1}.chips button.sel{outline:2px solid var(--a)}
.grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:10px}
.stc{border:1px solid;border-radius:18px;padding:14px;background:var(--card);animation:pop .5s both}.stc div{font-size:22px}.stc b{display:block;font-size:30px}
.cap{background:rgba(0,0,0,.4);border:1px solid var(--bd);border-radius:14px;padding:10px 12px;margin:8px 0;min-height:56px;font-size:14px;line-height:1.5;animation:pop .3s}
.sw{position:relative;width:46px;height:26px;border-radius:99px;background:var(--bd);flex:none;transition:.3s}.sw::after{content:"";position:absolute;top:3px;left:3px;width:20px;height:20px;border-radius:50%;background:#fff;transition:.3s}.sw.on{background:var(--a)}.sw.on::after{transform:translateX(20px)}
</style></head>
<body><div id="app"></div><div id="toast"></div>
<script>window.APP_MODE='user'</script>
<script type="module">
import {initializeApp} from "https://www.gstatic.com/firebasejs/10.12.2/firebase-app.js";
import {getDatabase,ref,get,set,push,update,remove,onValue} from "https://www.gstatic.com/firebasejs/10.12.2/firebase-database.js";

/* ============ কনফিগ ============ */
const firebaseConfig={apiKey:"AIzaSyDk5FT37Jc_Bgs0470b__T6akIJvbRQh80",authDomain:"nova-king-ai.firebaseapp.com",databaseURL:"https://nova-king-ai-default-rtdb.firebaseio.com",projectId:"nova-king-ai",storageBucket:"nova-king-ai.firebasestorage.app",messagingSenderId:"1059361232227",appId:"1:1059361232227:web:b6c2a205c3dbbd531daf56"};
// AI বটের জন্য Gemini API key এখানে বসান (aistudio.google.com/apikey)
const AI_KEY="AQ.Ab8RN6JPF65rxpNhjmCxwekYIvQEZyJKo5mTjJadTch-6KxTIg"; // AI মস্তিষ্ক (বোঝা ও উত্তর তৈরি)
const ELEVEN_KEY="sk_ee24e1fb2d071efd8f2129cdd959209ae091596bf5da24e5"; // ElevenLabs — কণ্ঠের জন্য (বাংলায় সেরা)
const ELEVEN_VOICE="EXAVITQu4vr4xnSDxMaL"; // Bella — মেয়েলি কণ্ঠ
// ElevenLabs (কণ্ঠের জন্য, বাংলা সাপোর্ট: eleven_v3)। ফাঁকা রাখলে শুধু Gemini কণ্ঠ ব্যবহার হবে
const EL_KEY="sk_ee24e1fb2d071efd8f2129cdd959209ae091596bf5da24e5";
// Google Drive স্টোরেজ — পরে এখানে বসাবেন (ফাঁকা রাখা হয়েছে)
const DRIVE={clientId:"",apiKey:"",folderId:""};
async function driveSave(name,data){ if(!DRIVE.clientId)return false; /* TODO: Google Drive API আপলোড কোড এখানে যোগ হবে */ return false; }
/* ================================= */

const D=getDatabase(initializeApp(firebaseConfig));
const R=p=>ref(D,p),$=s=>document.querySelector(s),DAY=864e5;
const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const toast=m=>{const t=$('#toast');t.textContent=m;t.classList.add('show');setTimeout(()=>t.classList.remove('show'),2400)};
const fmt=t=>new Date(t).toLocaleDateString('bn-BD',{day:'numeric',month:'short',year:'numeric'});
const admin=window.APP_MODE?window.APP_MODE==='admin':location.hash==='#admin';
const S={plans:{},methods:{},orders:{},updates:{},users:{},settings:{},headlines:{},tasks:{},mem:{},chat:[],user:null,loaded:false,uid:localStorage.uid||'',tab:admin?'dash':'home',adm:sessionStorage.adm==='1'};
const ML={bkash:'বিকাশ',nagad:'নগদ',bank:'ব্যাংক একাউন্ট'};
const dur=d=>d>=365?'১ বছর':d>=30?Math.round(d/30)+' মাস':d>=7?Math.round(d/7)+' সপ্তাহ':d+' দিন';

/* ---- লাইভ ডাটা ---- */
[['plans','plans'],['methods','methods'],['orders','orders'],['updates','updates'],['settings','settings'],['headlines','headlines']].forEach(([k,p])=>onValue(R(p),s=>{S[k]=s.val()||{};if(k==='settings')S.loaded=true;draw()}));
if(admin)onValue(R('users'),s=>{S.users=s.val()||{};draw()});
function listenUser(){if(!S.uid)return;onValue(R('users/'+S.uid),s=>{S.user=s.val();S.loaded=true;if(S.user?.active&&!S.started){S.started=1;earStart().then(()=>{lock();keepAlive(true);startIdle()}).catch(()=>toast('গোলকে ট্যাপ করে মাইক চালু করুন'))}draw()});onValue(R('memory/'+S.uid),s=>{S.mem=s.val()||{};if(S.tab==='memory')draw(true)});onValue(R('tasks/'+S.uid),s=>{S.tasks=s.val()||{};draw()});onValue(R('reminders/'+S.uid),s=>{S.rem=s.val()||{};if(S.tab==='tasks')draw(true)});onValue(R('log/'+S.uid),s=>{S.log=Object.values(s.val()||{}).sort((x,y)=>x.at0-y.at0).map(x=>new Date(x.at0).toLocaleString('bn-BD')+' '+x.t)});get(R('chats/'+S.uid)).then(s=>{S.chat=s.val()||[];drawMsgs()})}
if(!admin)listenUser();

function access(){const u=S.user,n=Date.now();if(!u)return{ok:false};if(u.premiumUntil>n)return{ok:true,pre:true,end:u.premiumUntil};if(u.trialEnd>n)return{ok:true,end:u.trialEnd};return{ok:false}}
const left=e=>{const h=Math.ceil((e-Date.now())/36e5);return h>=24?Math.ceil(h/24)+' দিন':h+' ঘণ্টা'};

/* ---- রেন্ডার ---- */
function draw(force){
  if(!S.loaded)return;
  if(!admin&&S.tab==='chat'&&!force&&$('#msgs')){$('#pill').outerHTML=pill();return}
  $('#app').innerHTML=admin?adminHTML():userHTML();
  if($('#msgs'))drawMsgs();cancelAnimationFrame(raf);if($('#cv'))sphere();stl();countUp();
}
const pill=()=>{const a=access();return `<span id="pill" class="pill ${a.ok?'ok':'er'}">${a.pre?'প্রিমিয়াম • '+fmt(a.end):a.ok?'ফ্রি ট্রায়াল • '+left(a.end):'মেয়াদ শেষ'}</span>`};
const nav=(items)=>`<nav>${items.map(([k,l])=>`<button class="${S.tab===k?'on':''}" data-act="tab" data-k="${k}">${l}</button>`).join('')}</nav>`;

function userHTML(){
  const u=S.user;
  if(!S.uid||!u)return `<div class="card" style="margin-top:12vh"><div class="top"><b>Nova King AI</b></div><p class="m">নাম ও মোবাইল নম্বর দিয়ে শুরু করুন। নতুন হলে ফ্রি ট্রায়াল পাবেন।</p><input id="nm" placeholder="আপনার নাম"><input id="ph" type="tel" placeholder="মোবাইল নম্বর"><button style="width:100%;margin-top:8px" data-act="login">লগইন করুন</button></div>`;
  if(S.showPerm){const P=S.perm||{},row=(k,i,t,d)=>`<div class="card row"><div><b>${i} ${t}</b><div class="m">${d}</div></div><span class="st ${P[k]?'approved':'pending'}">${P[k]?'✓ দেওয়া হয়েছে':'বাকি'}</span></div>`;
    return `<div class="card" style="margin-top:5vh"><div class="top"><b>অনুমতি দিন</b></div><p class="m">Nova ঠিকমতো কাজ করতে এগুলো দরকার।</p></div>`+row('mic','🎤','মাইক্রোফোন','আপনার কথা শোনার জন্য')+row('noti','🔔','নোটিফিকেশন','ব্যাকগ্রাউন্ডে জানানোর জন্য')+row('store','💾','স্টোরেজ / মেমোরি','চ্যাট ও স্মৃতি সেভ রাখার জন্য')+row('lock','🔋','স্ক্রিন জাগিয়ে রাখা','চালু থাকলে ফোন ঘুমিয়ে না পড়তে')+`<button style="width:100%" data-act="permall">সব অনুমতি দিন</button><button class="g" style="width:100%;margin-top:8px" data-act="permskip">সেটিংসে ফিরুন</button>`}
