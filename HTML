<title>Nova King AI</title>
<style>
:root{--bg:#060a18;--card:rgba(255,255,255,.07);--bd:rgba(255,255,255,.12);--t:#eaf0ff;--m:#8b97b8;--a:#00e0ff;--b:#7b5cff;--ok:#22d39a;--er:#ff5c7a}
