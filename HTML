nav button.on{color:#04121f;background:linear-gradient(90deg,var(--a),var(--b))}
.st{font-size:11px;padding:3px 9px;border-radius:99px}
.st.pending{background:#ffb02033;color:#ffb020}.st.approved{background:#22d39a33;color:var(--ok)}.st.rejected{background:#ff5c7a33;color:var(--er)}
