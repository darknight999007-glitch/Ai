.top small{display:block;color:var(--m);font-size:12px}
.pill{font-size:12px;padding:6px 12px;border-radius:99px;border:1px solid var(--bd)}
.pill.ok{color:var(--ok);border-color:var(--ok)}.pill.er{color:var(--er);border-color:var(--er)}
